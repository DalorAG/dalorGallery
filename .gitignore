# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
backend/node_modules/
backend/.cache/
# Die SQLite-Datei gehoert NICHT ins Repository. Strapi Cloud deployt aus
# dalorGalleryAdmin: eine mitgelieferte data.db ueberschreibt beim Deploy die
# Live-Datenbank. Genau so gingen am 08.09.2026 vier Kategorien verloren.
backend/.tmp/
backend/build/
backend/dist/
backend/public/uploads/*
!backend/public/uploads/.gitkeep
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Temporaere Upload-Ordner und Logs der Agenten
backend/public/__tmp*
backend/*.log

.vercel
.env*

# Sitzungsprotokoll zur Fashion-Rettung: 33 MB, bleibt lokal
wiederherstellung/fashion/sitzungsprotokoll.jsonl

# Zwischenlager fuer Bild-Uebertragungen, gehoert nicht ins Repo
bilder-upload/
